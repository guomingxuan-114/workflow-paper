{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-workflow.example/schemas/workflow-import.v1.schema.json",
  "title": "Workflow Import Protocol v1",
  "description": "结构化程序版本快照导入协议。适配器只读取该 JSON，不解析任意源码。",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "version", "source", "nodes", "edges"],
  "properties": {
    "format": {
      "const": "workflow-import"
    },
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "type": "string"
          },
          "collapsed": {
            "type": "boolean"
          },
          "color": {
            "enum": ["sage", "sand"]
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "type": {
            "enum": ["start", "task", "decision", "milestone", "end", "note"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "symbol": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
